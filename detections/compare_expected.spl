| rename disposition AS actual_disposition baseline_unknown AS actual_baseline_unknown method_deviation AS actual_method_deviation policy_unknown AS actual_policy_unknown policy_violation AS actual_policy_violation mfa_violation AS actual_mfa_violation telemetry_unknown AS actual_telemetry_unknown failed_mfa_on_success AS actual_failed_mfa_on_success mfa_note AS actual_mfa_note exception_applied AS actual_exception_applied exception_id AS actual_exception_id occurrences AS actual_occurrences
| lookup c07_expected.csv event_id OUTPUT case disposition baseline_unknown method_deviation policy_unknown policy_violation mfa_violation telemetry_unknown failed_mfa_on_success mfa_note exception_applied exception_id occurrences
| eval matched=if(isnotnull('case') AND actual_disposition=disposition AND actual_baseline_unknown=tonumber(baseline_unknown) AND actual_method_deviation=tonumber(method_deviation) AND actual_policy_unknown=tonumber(policy_unknown) AND actual_policy_violation=tonumber(policy_violation) AND actual_mfa_violation=tonumber(mfa_violation) AND actual_telemetry_unknown=tonumber(telemetry_unknown) AND actual_failed_mfa_on_success=tonumber(failed_mfa_on_success) AND actual_mfa_note=mfa_note AND actual_exception_applied=tonumber(exception_applied) AND coalesce(actual_exception_id,"")=coalesce(exception_id,"") AND actual_occurrences=tonumber(occurrences),1,0)
| table event_id case matched actual_disposition disposition actual_exception_id exception_id
